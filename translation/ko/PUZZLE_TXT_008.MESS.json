{
 "file": "MESS/PUZZLE_TXT_008.MESS",
 "type": "strings",
 "strings": [
  {
   "offset": 64,
   "block": 60,
   "part": 0,
   "ko": "원의 중심을 가리킨 뒤\nA 버튼을 눌러 주세요."
  },
  {
   "offset": 179,
   "block": 175,
   "part": 0,
   "ko": "본인 확인을 위해\n사용자의 얼굴 인증을 시작합니다."
  },
  {
   "offset": 326,
   "block": 322,
   "part": 0,
   "ko": "카메라를 향해 얼굴을 돌려\n화면 중앙의 틀에 맞춰 주세요."
  },
  {
   "offset": 482,
   "block": 478,
   "part": 0,
   "ko": "    얼굴을 화면 중앙의 틀에 맞춰 주세요."
  },
  {
   "offset": 613,
   "block": 609,
   "part": 0,
   "ko": "인증 중…"
  },
  {
   "offset": 666,
   "block": 662,
   "part": 0,
   "ko": "인증이 완료되었습니다."
  },
  {
   "offset": 743,
   "block": 739,
   "part": 0,
   "ko": "사용자 이름:\n애슐리 미즈키 로빈스"
  },
  {
   "offset": 824,
   "block": 820,
   "part": 0,
   "ko": "생년월일:\n1991년 2월 25일"
  },
  {
   "offset": 941,
   "block": 937,
   "part": 0,
   "ko": "잠금을 해제합니다."
  },
  {
   "offset": 991,
   "block": 987,
   "part": 0,
   "ko": "잠금 해제 메시지를 표시합니다."
  },
  {
   "offset": 1071,
   "block": 1067,
   "part": 0,
   "ko": "사랑하는 애슐리에게\n너에게 들려주고 싶은 엄마 이야기가 있단다."
  },
  {
   "offset": 1200,
   "block": 1196,
   "part": 0,
   "ko": "줄리엣 레이크에서 기다리마\n                              리처드"
  },
  {
   "offset": 1341,
   "block": 1337,
   "part": 0,
   "ko": "    DUAL ANOTHER SYSTEM\n                  START"
  },
  {
   "offset": 1404,
   "block": 1400,
   "part": 0,
   "ko": "              인증하지 못했습니다."
  }
 ]
}