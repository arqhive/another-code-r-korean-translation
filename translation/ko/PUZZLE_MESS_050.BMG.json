 "messages": [
  {
   "id": 0,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "시험관에 물을 뜨고…"
    },
    {
     "speaker": "アシュレイ",
     "ko": "다음은 빨간 선까지 시약을 넣는 거구나."
    }
   ]
  },
  {
   "id": 1,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "「간이 수질 검사 키트 MS100P"
    },
    {
     "speaker": "アシュレイ",
     "ko": "이 키트는 수소 이온 농도(pH)를\n측정하기 위한 세트입니다."
    },
    {
     "speaker": "アシュレイ",
     "ko": "전용 시약을 사용해\n물의 산성·알칼리성 여부를 판별합니다."
    },
    {
     "speaker": "アシュレイ",
     "ko": "시약을 빨간 선까지 넣으면 반응합니다\n너무 많이 넣으면 정확히 판별할 수 없습니다."
    },
    {
     "speaker": "アシュレイ",
     "ko": "판별 결과는 색깔로 확인할 수 있습니다."
    },
    {
     "speaker": "アシュレイ",
     "ko": "알칼리성은 분홍색, 산성은 빨간색,\n강산성은 짙은 빨간색입니다."
    },
    {
     "speaker": "アシュレイ",
     "ko": "색깔이 변하지 않으면\n중성입니다」"
    }
   ]
  },
  {
   "id": 3,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "아, 너무 많이 넣었어…"
    }
   ]
  },
  {
   "id": 4,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "아, 섞어 버렸네…"
    }
   ]
  },
  {
   "id": 5,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "아, 쏟았어…"
    }
   ]
  },
  {
   "id": 6,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "이쪽은 빈 병이야."
    }
   ]
  },
  {
   "id": 7,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "더 넣어야 해…"
    }
   ]
  },
  {
   "id": 8,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "좋아, 이 정도면 됐어."
    }
   ]
  },
  {
   "id": 9,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "시험관을 똑바로 세워 들어야 해."
    }
   ]
  },
  {
   "id": 10,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "좋아, 이제 시험관을 흔들자"
    }
   ]
  },
  {
   "id": 11,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "여기 물은 알칼리성이구나."
    }
   ]
  },
  {
   "id": 12,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "여기 물은 산성이구나."
    }
   ]
  },
  {
   "id": 13,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "여기 물은 강산성이구나."
    }
   ]
  },
  {
   "id": 14,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "여기 물은 중성이구나."
    }
   ]
  },
  {
   "id": 15,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "여기 물은 좋지 않구나."
    }
   ]
  },
  {
   "id": 16,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "여기 물은 좋은 물 같아…"
    }
   ]
  }
 ]
