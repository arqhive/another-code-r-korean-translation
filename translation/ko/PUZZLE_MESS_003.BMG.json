{
 "file": "MESS/PUZZLE_MESS_003.BMG",
 "type": "bmg",
 "count": 33,
 "messages": [
  {
   "id": 0,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "「DAS를 넣어 주세요」?"
    },
    {
     "speaker": "アシュレイ",
     "ko": "설마 이 컴퓨터를 쓰려면\n…DAS가 필요한 건가?"
    }
   ]
  },
  {
   "id": 1,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "…컴퓨터가 켜진 것 같네."
    }
   ]
  },
  {
   "id": 2,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "…아니야\n이건 인터넷 아이콘이 아니야."
    }
   ]
  },
  {
   "id": 3,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "여기에 검색하고 싶은 단어를\n입력하면 되는구나."
    },
    {
     "speaker": "アシュレイ",
     "ko": "먼저 「마이클 크루소」에 대해\n알아보자."
    }
   ]
  },
  {
   "id": 4,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "전미 로또 당첨금으로 회사 설립!\n1999년 제23회 전미 로또에서"
    },
    {
     "speaker": "アシュレイ",
     "ko": "300만 달러라는 거액을 거머쥔\n마이클 크루소 씨는"
    },
    {
     "speaker": "アシュレイ",
     "ko": "고향 줄리엣 레이크의 아름다움을\n미국 전역에 알리겠다는 꿈을 이루기 위해"
    },
    {
     "speaker": "アシュレイ",
     "ko": "크루소 리조트를 설립했다."
    },
    {
     "speaker": "アシュレイ",
     "ko": "그는 이번 회사 설립으로 로또 당첨 이상의\n행운을 거머쥐게 될 것인가."
    },
    {
     "speaker": "アシュレイ",
     "ko": "…매슈의 아빠는\n정말 부자였구나."
    },
    {
     "speaker": "アシュレイ",
     "ko": "로또 당첨금으로\n회사를 차린 거네."
    }
   ]
  },
  {
   "id": 5,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "그럼 다음은…"
    },
    {
     "speaker": "アシュレイ",
     "ko": "「크루소 리조트」에 대해\n알아보자."
    }
   ]
  },
  {
   "id": 6,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "아, 크루소 리조트\n홈페이지가 있어."
    },
    {
     "speaker": "アシュレイ",
     "ko": "…응? 첫 화면에 뭔가 적혀 있어."
    },
    {
     "speaker": "アシュレイ",
     "ko": "새 소식      2002년 3월 8일"
    },
    {
     "speaker": "アシュレイ",
     "ko": "이메일 문의 서비스를\n중단합니다."
    },
    {
     "speaker": "アシュレイ",
     "ko": "이용하시는 여러분께 불편을 끼쳐 드려\n깊이 사과드립니다."
    },
    {
     "speaker": "アシュレイ",
     "ko": "2002년에 쓴 글이야."
    },
    {
     "speaker": "アシュレイ",
     "ko": "이 홈페이지는\n5년 전부터 갱신되지 않았구나."
    }
   ]
  },
  {
   "id": 7,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "비밀번호가 필요해?"
    }
   ]
  },
  {
   "id": 8,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "폴더를 여는 비밀번호는…"
    }
   ]
  },
  {
   "id": 9,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "좋아, 비밀번호를 입력했어."
    }
   ]
  },
  {
   "id": 10,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "…안 돼. 비밀번호가 이게 아닌가 봐."
    }
   ]
  },
  {
   "id": 11,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "「DAS의 커넥트를 시작합니다」"
    },
    {
     "speaker": "アシュレイ",
     "ko": "…응? 방금 안내는 무슨 뜻이지?"
    }
   ]
  },
  {
   "id": 12,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "메일이 신경 쓰이네…"
    }
   ]
  },
  {
   "id": 14,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "매슈의 아빠에 대해서는 알아봤으니\n인터넷은 더 안 봐도 되겠지."
    }
   ]
  },
  {
   "id": 15,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "…아니야, 이건 메일 아이콘이야\n이건 안 봐도 돼."
    }
   ]
  },
  {
   "id": 16,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "「MEMO」라고 적혀 있지만\n이건 아빠의 일기구나…"
    }
   ]
  },
  {
   "id": 17,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "인터넷 아이콘을 선택하고…"
    }
   ]
  },
  {
   "id": 18,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "이게 검색 페이지구나."
    }
   ]
  },
  {
   "id": 19,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "호수 사진이야\n여기는 어디지?"
    }
   ]
  },
  {
   "id": 20,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "이곳은 본 적이 있는 것 같은데…"
    }
   ]
  },
  {
   "id": 21,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "이거 아빠가 찍은 사진일까?"
    }
   ]
  },
  {
   "id": 22,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "…아빠는 이런 생각을 하고 있었구나."
    }
   ]
  },
  {
   "id": 23,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "…이해할 수 없는 메일이라니, 무슨 말이지?"
    }
   ]
  },
  {
   "id": 24,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "아빠는 호수 오염을 조사하고 있었구나…"
    }
   ]
  },
  {
   "id": 25,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "…아빠"
    }
   ]
  },
  {
   "id": 26,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "마이크는 누구지…?"
    }
   ]
  },
  {
   "id": 27,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "제시카 고모가 나 몰래\n아빠에게 연락해 주고 있었구나."
    }
   ]
  },
  {
   "id": 28,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "이 메일은 제시카 고모가 전화로 말했던\n렉스라는 사람이 보낸 거야."
    },
    {
     "speaker": "アシュレイ",
     "ko": "아빠는 이 사람의 권유로\nJC 밸리에서 일하게 됐구나."
    },
    {
     "speaker": "アシュレイ",
     "ko": "…응? 렉스?"
    },
    {
     "speaker": "アシュレイ",
     "ko": "…아\n엘리자베스 아빠 이름인가?"
    }
   ]
  },
  {
   "id": 29,
   "boxes": [
    {
     "speaker": "アシュレイ",
     "ko": "…발신자 불명의 메일"
    },
    {
     "speaker": "アシュレイ",
     "ko": "제시카 고모가 말한 메일이…\n이거였구나."
    }
   ]
  }
 ]
}