{
 "file": "MESS/ITEM.MESS",
 "type": "strings",
 "strings": [
  {
   "offset": 524,
   "block": 520,
   "part": 0,
   "ko": "테디 베어\n테디 베어\n테디 베어\n테디 베어\n테디 베어\n테디 베어"
  },
  {
   "offset": 632,
   "block": 628,
   "part": 0,
   "ko": "도둑맞은 가방에\n들어 있던 테디 베어\n\n세 살 생일에 아빠와\n엄마에게 받은,\n소중한 추억이 담긴 물건."
  },
  {
   "offset": 896,
   "block": 892,
   "part": 0,
   "ko": "설명 2"
  },
  {
   "offset": 936,
   "block": 932,
   "part": 0,
   "ko": "설명 3"
  },
  {
   "offset": 976,
   "block": 972,
   "part": 0,
   "ko": "설명 4"
  },
  {
   "offset": 1016,
   "block": 1012,
   "part": 0,
   "ko": "설명 5"
  },
  {
   "offset": 1056,
   "block": 1052,
   "part": 0,
   "ko": "설명 6"
  },
  {
   "offset": 1096,
   "block": 1092,
   "part": 0,
   "ko": "쿨팝\n쿨팝\n쿨팝\n쿨팝\n쿨팝\n쿨팝"
  },
  {
   "offset": 1222,
   "block": 1218,
   "part": 0,
   "ko": "게스트하우스에서 산\n탄산음료\n\n상큼한 레몬 향이 나서\n요즘 제일 좋아하는\n음료야♪"
  },
  {
   "offset": 1453,
   "block": 1449,
   "part": 0,
   "ko": "설명 6"
  },
  {
   "offset": 1493,
   "block": 1489,
   "part": 0,
   "ko": "메달\n메달\n메달\n메달\n메달\n메달"
  },
  {
   "offset": 1565,
   "block": 1561,
   "part": 0,
   "ko": "빈 캔 수거기에서\n나온 메달\n\n앞면에 줄리엣 레이크\n로고가 새겨져 있다."
  },
  {
   "offset": 1784,
   "block": 1780,
   "part": 0,
   "ko": "설명 6"
  },
  {
   "offset": 1824,
   "block": 1820,
   "part": 0,
   "ko": "숯\n숯\n숯\n숯\n숯\n숯"
  },
  {
   "offset": 1932,
   "block": 1928,
   "part": 0,
   "ko": "게스트하우스에서\n받은 숯\n\n바비큐에 쓰는 숯이다."
  },
  {
   "offset": 2066,
   "block": 2062,
   "part": 0,
   "ko": "설명 6"
  },
  {
   "offset": 2106,
   "block": 2102,
   "part": 0,
   "ko": "캠핑장 ID 카드\n캠핑장 ID 카드\n캠핑장 ID 카드\n캠핑장 ID 카드\n캠핑장 ID 카드\n캠핑장 ID 카드"
  },
  {
   "offset": 2412,
   "block": 2408,
   "part": 0,
   "ko": "게스트하우스에서\n받은 ID 카드\n\n캠핑장 문을 열 때\n필요하다."
  },
  {
   "offset": 2579,
   "block": 2575,
   "part": 0,
   "ko": "게스트하우스에서\n받은 ID 카드\n\n캠핑장 문을 열 때\n필요하다.\n게스트하우스에서 산 물건도\n이걸로 계산할 수 있다."
  },
  {
   "offset": 2847,
   "block": 2843,
   "part": 0,
   "ko": "설명 6"
  },
  {
   "offset": 2887,
   "block": 2883,
   "part": 0,
   "ko": "감자칩\n감자칩\n감자칩\n감자칩\n감자칩\n감자칩"
  },
  {
   "offset": 3031,
   "block": 3027,
   "part": 0,
   "ko": "게스트하우스에서 산\n감자칩"
  },
  {
   "offset": 3105,
   "block": 3101,
   "part": 0,
   "ko": "설명 6"
  },
  {
   "offset": 3145,
   "block": 3141,
   "part": 0,
   "ko": "사요코의 펜던트\n사요코의 펜던트\n사요코의 펜던트\n사요코의 펜던트\n사요코의 펜던트\n사요코의 펜던트"
  },
  {
   "offset": 3325,
   "block": 3321,
   "part": 0,
   "ko": "엄마의 펜던트\n\n엄마의 유품이자\n소중한 추억이 담긴 물건."
  },
  {
   "offset": 3479,
   "block": 3475,
   "part": 0,
   "ko": "엄마의 기억이 담긴\n액체 메모리\n\n13년 전 시계탑에서\n엘리자베스의 아빠가\n엄마에게 건넨 것이다."
  },
  {
   "offset": 3722,
   "block": 3718,
   "part": 0,
   "ko": "설명 6"
  },
  {
   "offset": 3762,
   "block": 3758,
   "part": 0,
   "ko": "분홍색 음악 플레이어\n엘리자베스의 음악 플레이어\n엘리자베스의 음악 플레이어\n엘리자베스의 음악 플레이어\n엘리자베스의 음악 플레이어\n엘리자베스의 음악 플레이어"
  },
  {
   "offset": 4116,
   "block": 4112,
   "part": 0,
   "ko": "폐가에 있던\n음악 플레이어\n\n엘리자베스의 것…?"
  },
  {
   "offset": 4237,
   "block": 4233,
   "part": 0,
   "ko": "폐가에 있던\n음악 플레이어\n\n분명 엘리자베스의\n것이다."
  },
  {
   "offset": 4368,
   "block": 4364,
   "part": 0,
   "ko": "설명 6"
  },
  {
   "offset": 4408,
   "block": 4404,
   "part": 0,
   "ko": "DAS\nDAS\nDAS\nDAS\nDAS\nDAS"
  },
  {
   "offset": 4558,
   "block": 4554,
   "part": 0,
   "ko": "아빠가 개발한 기계\n\n네트워크에 아빠가\n남긴 메시지를 보거나\n사진을 찍을 수 있다."
  },
  {
   "offset": 4801,
   "block": 4797,
   "part": 0,
   "ko": "아빠가 개발한 기계\n\n아빠의 노트북에\n연결했더니 감시 카메라\n영상도 볼 수 있게 됐다."
  },
  {
   "offset": 5032,
   "block": 5028,
   "part": 0,
   "ko": "아빠가 개발한 기계\n\n메시지와 카메라\n기능이 있다.\n감시 카메라 데이터가\n연구소 내부로 바뀌었다."
  },
  {
   "offset": 5302,
   "block": 5298,
   "part": 0,
   "ko": "설명 6"
  },
  {
   "offset": 5342,
   "block": 5338,
   "part": 0,
   "ko": "반창고\n반창고\n반창고\n반창고\n반창고\n반창고"
  },
  {
   "offset": 5468,
   "block": 5464,
   "part": 0,
   "ko": "아빠의 코티지에\n있던 반창고\n\n상처를 치료하는 것 말고도\n쓸 데가 있을지도…"
  },
  {
   "offset": 5632,
   "block": 5628,
   "part": 0,
   "ko": "설명 6"
  },
  {
   "offset": 5672,
   "block": 5668,
   "part": 0,
   "ko": "육포\n육포\n육포\n육포\n육포\n육포"
  },
  {
   "offset": 5841,
   "block": 5830,
   "part": 0,
   "ko": "게스트하우스에서 산\n육포"
  },
  {
   "offset": 5911,
   "block": 5907,
   "part": 0,
   "ko": "매슈의 가족사진\n매슈의 가족사진\n매슈의 가족사진\n매슈의 가족사진\n매슈의 가족사진\n매슈의 가족사진"
  },
  {
   "offset": 6289,
   "block": 6285,
   "part": 0,
   "ko": "매슈에게 빌린\n매슈의 가족사진\n\n뒷면에 뭔가 적혀\n있는 것 같다…"
  },
  {
   "offset": 6477,
   "block": 6473,
   "part": 0,
   "ko": "설명 6"
  },
  {
   "offset": 6517,
   "block": 6513,
   "part": 0,
   "ko": "오렌지 쿨팝\n오렌지 쿨팝\n오렌지 쿨팝\n오렌지 쿨팝\n오렌지 쿨팝\n오렌지 쿨팝"
  },
  {
   "offset": 6715,
   "block": 6711,
   "part": 0,
   "ko": "아빠가 준비해 둔\n쿨팝\n\n계속 마셔 보고 싶었던\n신제품 오렌지 맛♪"
  },
  {
   "offset": 6891,
   "block": 6887,
   "part": 0,
   "ko": "설명 6"
  },
  {
   "offset": 6931,
   "block": 6927,
   "part": 0,
   "ko": "오렌지 쿨팝 빈 캔\n오렌지 쿨팝 빈 캔\n오렌지 쿨팝 빈 캔\n오렌지 쿨팝 빈 캔\n오렌지 쿨팝 빈 캔\n오렌지 쿨팝 빈 캔"
  },
  {
   "offset": 7327,
   "block": 7323,
   "part": 0,
   "ko": "다 마신 오렌지\n쿨팝의 빈 캔\n\n맛있었어.\n빈 캔은 수거기에\n넣으러 가자!"
  },
  {
   "offset": 7612,
   "block": 7608,
   "part": 0,
   "ko": "설명 6"
  },
  {
   "offset": 7652,
   "block": 7648,
   "part": 0,
   "ko": "거울\n거울\n거울\n거울\n거울\n거울"
  },
  {
   "offset": 7778,
   "block": 7774,
   "part": 0,
   "ko": "연구원실 책상 위에\n있던 거울\n\n분명 여자분의\n물건일 거야."
  },
  {
   "offset": 7972,
   "block": 7968,
   "part": 0,
   "ko": "설명 6"
  },
  {
   "offset": 8012,
   "block": 8008,
   "part": 0,
   "ko": "낚싯대\n낚싯대\n낚싯대\n낚싯대\n낚싯대\n낚싯대"
  },
  {
   "offset": 8084,
   "block": 8080,
   "part": 0,
   "ko": "연구원실 책상 옆에\n있던 낚싯대\n\n튼튼하게 만들어져서\n굉장히 비싸 보여…"
  },
  {
   "offset": 8308,
   "block": 8304,
   "part": 0,
   "ko": "설명 6"
  },
  {
   "offset": 8348,
   "block": 8344,
   "part": 0,
   "ko": "장난감 자동차\n장난감 자동차\n장난감 자동차\n장난감 자동차\n장난감 자동차\n장난감 자동차"
  },
  {
   "offset": 8438,
   "block": 8434,
   "part": 0,
   "ko": "호수에 있던 가방 속\n장난감 자동차\n\n매슈의 것이다."
  },
  {
   "offset": 8565,
   "block": 8561,
   "part": 0,
   "ko": "설명 6"
  },
  {
   "offset": 8605,
   "block": 8601,
   "part": 0,
   "ko": "리처드와 사요코의 사진\n리처드와 사요코의 사진\n리처드와 사요코의 사진\n리처드와 사요코의 사진\n리처드와 사요코의 사진\n리처드와 사요코의 사진"
  },
  {
   "offset": 8947,
   "block": 8943,
   "part": 0,
   "ko": "오래된 집 지하실에\n있던 기념사진\n\n인어상에서 찍은\n아빠와 엄마의 사진이다.\n두 분 다 젊으시네…"
  },
  {
   "offset": 9241,
   "block": 9237,
   "part": 0,
   "ko": "설명 6"
  },
  {
   "offset": 9281,
   "block": 9277,
   "part": 0,
   "ko": "반창고를 감은 호스\n반창고를 감은 호스\n반창고를 감은 호스\n반창고를 감은 호스\n반창고를 감은 호스\n반창고를 감은 호스"
  },
  {
   "offset": 9587,
   "block": 9583,
   "part": 0,
   "ko": "반창고로\n구멍을 막은 호스\n\n이제 구멍이\n막혔을 거야."
  },
  {
   "offset": 9733,
   "block": 9729,
   "part": 0,
   "ko": "반창고로\n구멍을 막은 호스\n\n이걸로는 구멍을\n다 막을 수 없었어…"
  },
  {
   "offset": 9873,
   "block": 9869,
   "part": 0,
   "ko": "설명 6"
  },
  {
   "offset": 9913,
   "block": 9909,
   "part": 0,
   "ko": "스프레이\n스프레이\n스프레이\n스프레이\n스프레이\n스프레이"
  },
  {
   "offset": 10003,
   "block": 9999,
   "part": 0,
   "ko": "회의실 선반에 있던\n스프레이\n\n「주의: 잘 흔들어서\n사용하세요」\n…라고 적혀 있다."
  },
  {
   "offset": 10225,
   "block": 10221,
   "part": 0,
   "ko": "설명 6"
  },
  {
   "offset": 10265,
   "block": 10261,
   "part": 0,
   "ko": "리처드의 가방\n리처드의 가방\n리처드의 가방\n리처드의 가방\n리처드의 가방\n리처드의 가방"
  },
  {
   "offset": 10445,
   "block": 10441,
   "part": 0,
   "ko": "캠핑장에 있던\n아빠의 가방\n\n정말, 아빠도 참…"
  },
  {
   "offset": 10548,
   "block": 10544,
   "part": 0,
   "ko": "설명 6"
  },
  {
   "offset": 10588,
   "block": 10584,
   "part": 0,
   "ko": "라이언의 트렁크\n라이언의 트렁크\n라이언의 트렁크\n라이언의 트렁크\n라이언의 트렁크\n라이언의 트렁크"
  },
  {
   "offset": 10768,
   "block": 10764,
   "part": 0,
   "ko": "캠핑장에 있던\n라이언의 트렁크\n\n표면이 왠지\n반들반들해."
  },
  {
   "offset": 10929,
   "block": 10925,
   "part": 0,
   "ko": "설명 6"
  },
  {
   "offset": 10969,
   "block": 10965,
   "part": 0,
   "ko": "동전\n동전\n동전\n동전\n동전\n동전"
  },
  {
   "offset": 11041,
   "block": 11037,
   "part": 0,
   "ko": "헛간 서랍에\n들어 있던 동전\n\n시계탑과 인어상\n그림이 새겨져 있다."
  },
  {
   "offset": 11271,
   "block": 11267,
   "part": 0,
   "ko": "설명 6"
  },
  {
   "offset": 11311,
   "block": 11307,
   "part": 0,
   "ko": "편지지\n편지지\n편지지\n편지지\n편지지\n편지지"
  },
  {
   "offset": 11419,
   "block": 11415,
   "part": 0,
   "ko": "오래된 집 서랍에\n들어 있던 편지지\n\n매슈가 그린\n보물 지도.\n…일 텐데\n아무것도 그려져 있지 않다."
  },
  {
   "offset": 11717,
   "block": 11713,
   "part": 0,
   "ko": "설명 6"
  },
  {
   "offset": 11757,
   "block": 11753,
   "part": 0,
   "ko": "종이 성냥\n종이 성냥\n종이 성냥\n종이 성냥\n종이 성냥\n종이 성냥"
  },
  {
   "offset": 11883,
   "block": 11879,
   "part": 0,
   "ko": "캠핑장에 있던\n종이 성냥\n\n곰 그림이 그려져 있어."
  },
  {
   "offset": 12011,
   "block": 12007,
   "part": 0,
   "ko": "설명 6"
  },
  {
   "offset": 12051,
   "block": 12047,
   "part": 0,
   "ko": "그림이 드러난 편지지\n그림이 드러난 편지지\n그림이 드러난 편지지\n그림이 드러난 편지지\n그림이 드러난 편지지\n그림이 드러난 편지지"
  },
  {
   "offset": 12309,
   "block": 12305,
   "part": 0,
   "ko": "오래된 집 서랍에\n들어 있던 편지지\n\n매슈가 그린\n보물 지도.\n불에 쬐자 그림이\n나타났다."
  },
  {
   "offset": 12619,
   "block": 12615,
   "part": 0,
   "ko": "설명 6"
  },
  {
   "offset": 12659,
   "block": 12655,
   "part": 0,
   "ko": "낡은 호스\n낡은 호스\n낡은 호스\n낡은 호스\n낡은 호스\n낡은 호스"
  },
  {
   "offset": 12839,
   "block": 12835,
   "part": 0,
   "ko": "공사가 중단된 코티지에\n있던 호스\n\n꽤 오래된 것 같아."
  },
  {
   "offset": 12975,
   "block": 12971,
   "part": 0,
   "ko": "공사가 중단된 코티지에\n있던 호스\n\n구멍이 나서\n이대로는 못 쓰겠어…"
  },
  {
   "offset": 13157,
   "block": 13153,
   "part": 0,
   "ko": "설명 6"
  },
  {
   "offset": 13197,
